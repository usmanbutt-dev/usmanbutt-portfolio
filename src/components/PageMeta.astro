---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/images/social-card.png', Astro.site);
const imageAlt = 'Muhammad Usman Butt — Software Engineer. Ideas made interactive. Unity and VR, web and mobile, AI systems.';
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Muhammad Usman Butt" />
<meta name="theme-color" content="#f4f2eb" />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.ico?v=2" sizes="16x16 32x32 48x48" />
<link rel="icon" href="/favicon-32.png?v=2" type="image/png" sizes="32x32" />
<link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Muhammad Usman Butt" />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
