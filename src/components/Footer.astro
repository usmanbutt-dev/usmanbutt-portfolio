---
// Footer.astro
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-left">
      <span class="mono">Muhammad Usman Butt</span>
      <span class="label">Full-Stack Engineer</span>
    </div>
    <div class="footer-right">
      <a href="mailto:buttu7666@gmail.com" class="footer-link">buttu7666@gmail.com</a>
      <a href="https://github.com/usmanbutt-dev" target="_blank" rel="noopener noreferrer" class="footer-link">GitHub ↗</a>
      <a href="https://linkedin.com/in/usmanbutt-dev" target="_blank" rel="noopener noreferrer" class="footer-link">LinkedIn ↗</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-ink);
    padding-block: var(--space-8);
    margin-top: var(--space-24);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .footer-right {
    display: flex;
    gap: var(--space-6);
    align-items: center;
    flex-wrap: wrap;
  }

  .footer-link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    letter-spacing: 0.04em;
    transition: color 0.15s ease;
  }
  .footer-link:hover {
    color: var(--color-accent);
  }
</style>
