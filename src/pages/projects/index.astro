import '@fontsource-variable/archivo';
import '../../styles/site.css';
const vibeCoded = new Set(['antigravity-unity', 'unity-mcp', 'ArcSmith', 'NijiStream', 'ZeroToCode', 'CineStream']);
const work=[
['antigravity-unity','Antigravity for Unity','Open-source integration connecting Antigravity to the Unity editor workflow.'],
['unity-mcp','Unity MCP','A Unity Editor MCP server. Development paused.'],
['SoftcomProject','SOFTCOM project','Our team’s first-place Game Development entry at GIKI SOFTCOM 2026.'],
['ArcSmith','ArcSmith','An open-source visual narrative editor built with React, TypeScript and Tauri.'],
['NijiStream','NijiStream','A Flutter media application built around JavaScript source extensions.'],
['ZeroToCode','ZeroToCode','Programming education with browser-based C++ execution and trace visualization.'],
['MountainClimberVR','MountainClimberVR','A Unity VR climbing prototype exploring release momentum and hazards.'],
['ThresholdGame','ThresholdGame','Procedural game generation with validation and hosted AI integrations.'],
['Pokedex','Pokedex','A React Native / Expo Pokédex with pagination and local caching.'],
['CineStream','CineStream','An extension-driven Flutter movies and television client.'],
['UnityModularInventorySystem','Unity inventory system','An exploration of item definitions, pickups, stacking and inventory UI.'],
['Pong','Pong','A Unity recreation with a reactive CPU opponent and local controls.'],
['WebTechProject','Web technology project','A Django portfolio backend with structured content models.'],
['DiceGame','Dice game','A small browser experiment with random rolls and comparison.'],
['ExpandingCards','Expanding cards','Exploring CSS panels and click-driven state.'],
['fizzBuzz','FizzBuzz','An interactive number-sequence exercise.'],
['rock-paper-scissors','Rock, paper, scissors','A browser game with a random computer opponent.'],
['etch-a-sketch','Etch-a-sketch','A drawing grid built from DOM elements.'],
['calculator','Calculator','An early browser calculator with keyboard and button input.'],
['tic-tac-toe','Tic-tac-toe','An early board-game exercise with random opponent moves.'],
['my-tic-tac-toe','Tic-tac-toe, revisited','A second exploration of board state and available moves.'],
['my-weather-checker','Weather checker','City-based current weather using the OpenWeatherMap API.'],
['admin-dashboard','Admin dashboard','A static dashboard layout built with HTML and CSS.'],
['boat-breaker','Boat Breaker','A Unity browser game demonstration.'],
];
const clientWork=[['CardGame','Freelance Unity card and board-game application with multiplayer systems.'],['AR_Navigation','Freelance AR navigation application with route guidance.'],['Ananse','Freelance Android educational application with interactive learning features.']];
