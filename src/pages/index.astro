---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    number: "01",
    name: "Pokédex App",
    repo: "https://github.com/usmanbutt-dev/Pokedex",
    demo: "https://github.com/user-attachments/assets/3e2b6f3d-f964-4f6d-afd0-c26d8d46a619",
    stack: ["React Native", "Expo", "TypeScript", "PokéAPI"],
    problem: "Build a complete, production-quality mobile app — not a tutorial clone. The challenge was consuming a third-party API responsibly while delivering a polished, performant experience.",
    decisions: [
      "Custom 24h TTL caching via AsyncStorage to respect PokéAPI's fair-use policy.",
      "Race condition handling using useRef guards to prevent stale async callbacks.",
      "Smart search fallback: filters loaded Pokémon first, falls back to direct API lookup if needed.",
      "Type-aware dynamic theming: UI recolors based on the Pokémon's primary type at runtime.",
    ],
    image: null,
  },
  {
    number: "02",
    name: "ArcSmith",
    repo: "https://github.com/usmanbutt-dev/ArcSmith",
    demo: null,
    stack: ["TypeScript", "React Flow", "Rust", "REST API"],
    problem: "Game writers and AI agents need a visual tool for branching narrative — a non-linear story graph editor that can be queried programmatically by external tools.",
    decisions: [
      "Node-based canvas using React Flow for the visual editing layer.",
      "Rust-based background REST API for performance-critical operations and asset library management.",
      "Architecture separates the visual layer from the data layer — the REST API is fully independent of the frontend.",
    ],
    image: null,
  },
  {
    number: "03",
    name: "antigravity-unity",
    repo: "https://github.com/usmanbutt-dev/antigravity-unity",
    demo: null,
    stars: 23,
    stack: ["C#", "Unity", "Editor Tooling"],
    problem: "Unity's built-in editor doesn't support modern AI-assisted coding environments. Developers working in Unity had no way to leverage the Google Antigravity IDE workflow.",
    decisions: [
      "Built as a Unity Package Manager (UPM) compatible package for frictionless installation.",
      "Bridges the Unity Editor event system with external IDE communication protocols.",
      "23 GitHub stars — adopted by other developers without any promotion.",
    ],
    image: null,
  },
];

const experience = [
  {
    company: "Termnl Tech",
    role: "Full-Stack & Mobile App Dev Intern | AI & RAG Engineer",
    period: "Jun 2026 — Present",
    points: [
      "Developed and optimized responsive cross-platform mobile features using React Native and web interfaces using React.js, improving front-end UI performance.",
      "Engineered and integrated efficient Retrieval-Augmented Generation (RAG) pipelines using Qdrant vector database and intelligent LLM workflows.",
      "Designed flexible, scalable data models in MongoDB and wrote secure server-side APIs to ensure low-latency data retrieval.",
    ],
  },
  {
    company: "Axiolink Game Studio",
    role: "Head of Game Development",
    period: "Apr 2026 — Jun 2026",
    points: [
      "Led the game development department, driving the team across the full production pipeline from concept to deployment.",
      "Focused on building intelligent, systems-driven games using Unity, with a strong interest in integrating agentic AI into gameplay experiences.",
      "Responsibilities included development strategy, team coordination, and hands-on engineering in C#.",
    ],
  },
  {
    company: "AstroApe Studios",
    role: "Unity Developer",
    period: "Sep 2025 — Jun 2026",
    points: [
      "Engineered multiplayer features that foster real-time interactions, bringing players together seamlessly.",
      "Optimized performance and scalability of applications, ensuring smooth user experiences across platforms.",
      "Collaborated with a creative team in a hybrid environment, merging artistic vision with technical execution.",
    ],
  },
  {
    company: "Freelancing",
    role: "Unity Developer",
    period: "Oct 2022 — Present",
    points: [
      "Designed and developed immersive 3D VR experiences that enhance interactive gameplay.",
      "Utilized Unity, VR Interaction Framework, Final IK, and Photon PUN 2 to create engaging multiplayer environments.",
      "Solved complex technical challenges, ensuring high-quality VR games that align with client goals and player expectations.",
    ],
  },
];

const education = [
  {
    institution: "University of Management and Technology - UMT",
    degree: "Bachelor of Science - BS, Computer Science",
    period: "Nov 2022 — Nov 2026",
    points: [
      "Coursework includes Object-Oriented Programming (OOP), Game Development, and foundational computer science principles."
    ]
  }
];

const credentials = [
  {
    title: "Game Development Team Member",
    organization: "UMT ACM Student Chapter & Google Developer Group on Campus",
    period: "Nov 2025 — Present",
    description: "Collaborating with fellow developers to design and build interactive applications using Unity and C#, while assisting in organizing workshops and game jams.",
  },
  {
    title: "Game Design and Development 1: 2D Shooter",
    organization: "Michigan State University",
    period: "Issued Jan 2025",
    description: "Certification in Unity game programming and systems design.",
  }
];

const skills = {
  "Frontend": ["React", "React Native", "JavaScript", "HTML / CSS"],
  "Backend": ["Node.js", "Rust", "Python", "C#"],
  "AI & ML": ["LangChain", "RAG Pipelines", "Qdrant", "MCP Protocol", "LLM Integration"],
  "Databases": ["MongoDB", "Firebase"],
  "Tools": ["Git", "Unity"],
};
---

<BaseLayout>

  <!-- ============ HERO ============ -->
  <section class="hero" id="home">
    <div class="container hero-inner">
      <div class="hero-text">
        <span class="label hero-label">Full-Stack Engineer</span>
        <h1 class="hero-name">Muhammad<br />Usman Butt</h1>
        <p class="hero-desc">
          I build production-grade web and mobile applications. 
          With a strong foundation in game development and interactive systems, 
          I now focus on full-stack engineering and AI-integrated products.
        </p>
        <div class="hero-actions">
          <a href="#projects" class="btn btn--filled">View My Work</a>
          <a href="/cv-placeholder.pdf" class="btn" download>Download CV</a>
        </div>
        <div class="hero-meta">
          <a href="mailto:butt7666@gmail.com" class="hero-contact-link">butt7666@gmail.com</a>
          <span class="hero-separator">·</span>
          <a href="https://github.com/usmanbutt-dev" target="_blank" rel="noopener noreferrer" class="hero-contact-link">github.com/usmanbutt-dev ↗</a>
        </div>
      </div>
      <div class="hero-photo">
        <div class="img-frame placeholder hero-placeholder">
          <span>Photo Placeholder</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-num accent">50</span>
          <span class="label">Public Repositories</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-num accent">23</span>
          <span class="label">GitHub Stars</span>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-rule" />

  <!-- ============ PROJECTS ============ -->
  <section class="projects" id="projects">
    <div class="container">
      <div class="section-header">
        <span class="label">Selected Work</span>
        <h2>Projects</h2>
      </div>

      <div class="project-list">
        {projects.map((p) => (
          <article class="project-block">
            <div class="project-left">
              <div class="project-top-row">
                <span class="mono project-number">{p.number}</span>
                {p.stars && (
                  <span class="project-stars mono">
                    ★ {p.stars} stars
                  </span>
                )}
              </div>
              <h3 class="project-name">{p.name}</h3>
              <div class="project-stack">
                {p.stack.map((t) => <span class="tag">{t}</span>)}
              </div>

              <div class="project-body">
                <div class="project-section">
                  <span class="label">Problem</span>
                  <p>{p.problem}</p>
                </div>
                <div class="project-section">
                  <span class="label">Key Decisions</span>
                  <ul class="project-decisions">
                    {p.decisions.map((d) => (
                      <li class="project-decision">{d}</li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="project-links">
                <a href={p.repo} target="_blank" rel="noopener noreferrer" class="btn">
                  View Code ↗
                </a>
                {p.demo && (
                  <a href={p.demo} target="_blank" rel="noopener noreferrer" class="btn">
                    Live Demo ↗
                  </a>
                )}
              </div>
            </div>

            <div class="project-right">
              <div class="img-frame placeholder project-img">
                <span class="mono" style="font-size: 0.65rem; color: var(--color-muted)">
                  {p.image ? "" : "Screenshot Placeholder"}
                </span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <hr class="section-rule" />

  <!-- ============ EXPERIENCE ============ -->
  <section class="experience" id="experience">
    <div class="container">
      <div class="section-header">
        <span class="label">Background</span>
        <h2>Experience</h2>
      </div>

      <div class="timeline">
        {experience.map((e, i) => (
          <div class="timeline-item">
            <div class="timeline-meta">
              <span class="mono timeline-period">{e.period}</span>
            </div>
            <div class="timeline-content">
              <div class="timeline-heading">
                <h3 class="timeline-company">{e.company}</h3>
                <span class="timeline-role label">{e.role}</span>
              </div>
              <ul class="timeline-points">
                {e.points.map((pt) => (
                  <li class="timeline-point">{pt}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="section-rule" />

  <!-- ============ EDUCATION ============ -->
  <section class="education" id="education">
    <div class="container">
      <div class="section-header">
        <span class="label">Academic</span>
        <h2>Education</h2>
      </div>

      <div class="timeline">
        {education.map((e) => (
          <div class="timeline-item">
            <div class="timeline-meta">
              <span class="mono timeline-period">{e.period}</span>
            </div>
            <div class="timeline-content">
              <div class="timeline-heading">
                <h3 class="timeline-company">{e.institution}</h3>
                <span class="timeline-role label">{e.degree}</span>
              </div>
              <ul class="timeline-points">
                {e.points.map((pt) => (
                  <li class="timeline-point">{pt}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="section-rule" />

  <!-- ============ CREDENTIALS & COMMUNITY ============ -->
  <section class="credentials" id="credentials">
    <div class="container">
      <div class="section-header">
        <span class="label">Community & Certifications</span>
        <h2>Credentials</h2>
      </div>

      <div class="timeline">
        {credentials.map((c) => (
          <div class="timeline-item">
            <div class="timeline-meta">
              <span class="mono timeline-period">{c.period}</span>
            </div>
            <div class="timeline-content">
              <div class="timeline-heading">
                <h3 class="timeline-company">{c.title}</h3>
                <span class="timeline-role label">{c.organization}</span>
              </div>
              <ul class="timeline-points">
                <li class="timeline-point">{c.description}</li>
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="section-rule" />

  <!-- ============ SKILLS ============ -->
  <section class="skills" id="skills">
    <div class="container">
      <div class="section-header">
        <span class="label">Toolbox</span>
        <h2>Skills</h2>
      </div>

      <div class="skills-grid">
        {Object.entries(skills).map(([category, items]) => (
          <div class="skills-group">
            <span class="label skills-category">{category}</span>
            <ul class="skills-list">
              {items.map((skill) => (
                <li class="skills-item">{skill}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- GitHub Strip -->
      <div class="github-strip">
        <span class="mono github-stat">50 public repositories</span>
        <span class="github-dot">·</span>
        <span class="mono github-stat"><span class="accent">★ 23 stars</span> earned on open-source tooling</span>
        <span class="github-dot">·</span>
        <a
          href="https://github.com/usmanbutt-dev"
          target="_blank"
          rel="noopener noreferrer"
          class="mono github-link"
        >
          github.com/usmanbutt-dev ↗
        </a>
      </div>
    </div>
  </section>

  <hr class="section-rule" />

  <!-- ============ ABOUT ============ -->
  <section class="about" id="about">
    <div class="container about-inner">
      <div class="about-text">
        <div class="section-header">
          <span class="label">Philosophy & Background</span>
          <h2>About</h2>
        </div>
        <blockquote style="font-family: var(--font-display); font-size: var(--text-md); line-height: 1.3; margin-bottom: var(--space-6); border-left: 2px solid var(--color-accent); padding-left: var(--space-4); font-weight: 500;">
          "In an era where AI can write code, I believe a great software engineer isn't defined by syntax, but by their ability to design, architect, and scale resilient systems."
        </blockquote>
        <p>
          I am a Full-Stack Engineer based in Pakistan with a recent BS in Computer Science from the 
          University of Management and Technology. I spent the early years of my career deeply immersed 
          in the game development industry, leading teams and engineering complex, real-time multiplayer 
          systems and VR experiences.
        </p>
        <p>
          Recently, I pivoted into full-stack and mobile development to tackle new engineering challenges. 
          At Termnl Tech, I am combining my rigorous background in systems architecture with modern web technologies 
          to build scalable RAG pipelines, intelligent backends, and performant cross-platform applications. 
          I bring the performance-obsessed mindset of a game developer to every web and mobile product I build.
        </p>
      </div>
      <div class="about-photo">
        <div class="img-frame placeholder about-placeholder">
          <span>Photo Placeholder</span>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-rule" />

  <!-- ============ CONTACT ============ -->
  <section class="contact" id="contact">
    <div class="container contact-inner">
      <span class="label">Get In Touch</span>
      <h2 class="contact-heading">Let's work together.</h2>
      <p class="contact-desc">
        I'm currently open to full-stack engineering roles.
        Email is the best way to reach me.
      </p>
      <a href="mailto:butt7666@gmail.com" class="btn btn--filled contact-cta">
        butt7666@gmail.com
      </a>
      <div class="contact-links">
        <a href="https://github.com/usmanbutt-dev" target="_blank" rel="noopener noreferrer" class="contact-link">
          GitHub ↗
        </a>
        <a href="https://linkedin.com/in/usmanbutt-dev" target="_blank" rel="noopener noreferrer" class="contact-link">
          LinkedIn ↗
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---- HERO ---- */
  .hero {
    padding-block: var(--space-24) var(--space-16);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: start;
  }

  .hero-label {
    display: block;
    margin-bottom: var(--space-4);
  }

  .hero-name {
    margin-bottom: var(--space-6);
    font-size: clamp(2.5rem, 7vw, var(--text-3xl));
  }

  .hero-desc {
    color: var(--color-muted);
    margin-bottom: var(--space-8);
    font-size: var(--text-md);
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  .hero-meta {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    flex-wrap: wrap;
  }

  .hero-contact-link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    letter-spacing: 0.04em;
    transition: color 0.15s ease;
  }
  .hero-contact-link:hover { color: var(--color-accent); }

  .hero-separator {
    color: var(--color-border);
    font-family: var(--font-mono);
  }

  .hero-photo {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-height: 600px;
  }

  .hero-placeholder {
    flex: 1;
    min-height: 0;
    aspect-ratio: unset;
    height: 100%;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .hero-stat-num {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    line-height: 1;
  }

  /* ---- SECTION HEADER ---- */
  .section-header {
    margin-bottom: var(--space-12);
  }

  .section-header .label {
    display: block;
    margin-bottom: var(--space-2);
  }

  /* ---- PROJECTS ---- */
  .project-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .project-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: start;
    padding-block: var(--space-12);
    border-bottom: var(--border);
  }
  .project-block:last-child {
    border-bottom: none;
  }

  .project-top-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .project-number {
    color: var(--color-muted);
  }

  .project-stars {
    color: var(--color-accent);
    font-size: var(--text-sm);
  }

  .project-name {
    margin-bottom: var(--space-4);
    font-size: clamp(var(--text-lg), 3vw, var(--text-xl));
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .project-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .project-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .project-section p {
    font-size: 0.95rem;
    color: var(--color-muted);
    max-width: 55ch;
  }

  .project-decisions {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .project-decision {
    font-size: 0.9rem;
    color: var(--color-muted);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
    line-height: 1.5;
  }

  .project-links {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .project-img {
    aspect-ratio: 16 / 10;
    position: sticky;
    top: 80px;
  }

  /* ---- EXPERIENCE ---- */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--space-8);
    padding-block: var(--space-8);
    border-bottom: var(--border);
  }
  .timeline-item:last-child { border-bottom: none; }

  .timeline-meta {
    padding-top: 4px;
  }

  .timeline-period {
    color: var(--color-muted);
  }

  .timeline-heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-4);
  }

  .timeline-company {
    font-size: var(--text-md);
    font-family: var(--font-display);
    font-weight: 700;
  }

  .timeline-role {
    color: var(--color-muted);
  }

  .timeline-points {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .timeline-point {
    font-size: 0.95rem;
    color: var(--color-muted);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-border);
    line-height: 1.55;
  }

  /* ---- SKILLS ---- */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  @media (max-width: 1024px) {
    .skills-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .skills-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .skills-category {
    display: block;
    border-bottom: var(--border-ink);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .skills-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .skills-item {
    font-size: 0.95rem;
    color: var(--color-muted);
    transition: color 0.15s ease;
  }
  .skills-item:hover { color: var(--color-ink); }

  /* GitHub Strip */
  .github-strip {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding: var(--space-4) var(--space-6);
    border: var(--border-ink);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .github-dot {
    color: var(--color-border);
    font-family: var(--font-mono);
  }

  .github-stat,
  .github-link {
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  .github-link {
    transition: color 0.15s ease;
  }
  .github-link:hover { color: var(--color-accent); }

  /* ---- ABOUT ---- */
  .about-inner {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-16);
    align-items: start;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .about-text p {
    font-size: 1.05rem;
    color: var(--color-muted);
    line-height: 1.75;
    max-width: 60ch;
  }

  .about-placeholder {
    aspect-ratio: 3 / 4;
    position: sticky;
    top: 80px;
  }

  /* ---- CONTACT ---- */
  .contact-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .contact-heading {
    font-size: clamp(var(--text-xl), 5vw, var(--text-2xl));
    margin: 0;
  }

  .contact-desc {
    color: var(--color-muted);
    max-width: 48ch;
  }

  .contact-cta {
    font-size: var(--text-base);
  }

  .contact-links {
    display: flex;
    gap: var(--space-6);
  }

  .contact-link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    letter-spacing: 0.04em;
    transition: color 0.15s ease;
  }
  .contact-link:hover { color: var(--color-accent); }

  /* ---- RESPONSIVE ---- */
  @media (max-width: 960px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-photo {
      flex-direction: row;
      align-items: flex-start;
    }

    .hero-placeholder {
      max-width: 280px;
    }

    .project-block {
      grid-template-columns: 1fr;
    }

    .project-img {
      position: static;
      order: -1;
    }

    .about-inner {
      grid-template-columns: 1fr;
    }

    .about-placeholder {
      position: static;
      max-width: 320px;
    }

